{
  "name": "cypress-saucedemo-framework",
  "version": "1.0.0",
  "description": "Cypress E2E, Session Caching, and Network Interception Framework for SauceDemo",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:smoke": "cypress run --spec 'cypress/e2e/smoke/**/*.cy.js'",
    "cy:run:regression": "cypress run --spec 'cypress/e2e/regression/**/*.cy.js'"
  },
  "keywords": [
    "cypress",
    "qa-automation",
    "e2e-testing",
    "saucedemo",
    "mochawesome"
  ],
  "license": "MIT",
  "devDependencies": {
    "cypress": "^13.15.0",
    "cypress-mochawesome-reporter": "^3.8.2"
  }
}
